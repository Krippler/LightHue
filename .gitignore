# Local Hue bridge credentials + saved patterns — never commit these
data/
config.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Env files, if you ever add one
.env
.env.*

# OS/editor cruft
.DS_Store
*.swp
.vscode/
.idea/

# Test/lint caches
.pytest_cache/
.ruff_cache/

# Agent skills installed by "npx skills add". Third-party, nothing to do with
# this app, and the installer drops them in the working tree — so they are
# kept out rather than vendored in.
.agents/
.claude/
skills-lock.json
